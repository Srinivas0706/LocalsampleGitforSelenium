		String[] arr = { "Apple", "Mango", "Orange", "Apple", "Mango", "Apple" };

		for (int i = 0; i < arr.length; i++) {

			int count = 1;

			if (arr[i].equals("")) {
				continue;
			}

			for (int j = i + 1; j < arr.length; j++) {

				if (arr[i].equals(arr[j])) {
					count++;
					arr[j] = "";
				}
			}

			System.out.println(arr[i] + " = " + count);
		}